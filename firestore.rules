rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function dir() {
      return get(/databases/$(database)/documents/directory/$(request.auth.uid)).data;
    }

    function hasDir() {
      return signedIn() && exists(/databases/$(database)/documents/directory/$(request.auth.uid));
    }

    function active() {
      return hasDir() && dir().status == 'active';
    }

    function role() {
      return active() ? dir().role : '';
    }

    function tenant() {
      return active() ? dir().tenantId : null;
    }

    function isSuperAdmin() {
      return signedIn() && (
        request.auth.token.email == 'anupdas8354@gmail.com' ||
        (hasDir() && dir().role == 'super_admin')
      );
    }

    // Master override for Platform Owner
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }

    // -------------------------------------------------------------
    // 1. IDENTITY DIRECTORY (/directory)
    // -------------------------------------------------------------
    match /directory/{uid} {
      allow read: if signedIn() && (isSuperAdmin() || request.auth.uid == uid);
      allow write: if signedIn() && (isSuperAdmin() || (request.auth.uid == uid && request.resource.data.email == request.auth.token.email));
    }

    // -------------------------------------------------------------
    // 2. USER ACCOUNTS & PROFILES (/users)
    // -------------------------------------------------------------
    match /users/{userId} {
      // Allow reading own profile by uid or by email query, or supervisor/super_admin or same tenant
      allow read: if signedIn() && (
        isSuperAdmin() ||
        resource.data.email == request.auth.token.email ||
        userId == request.auth.uid ||
        (active() && (
          role() in ['super_admin', 'zsm', 'asm'] ||
          (resource.data.tenantId != null && resource.data.tenantId == tenant()) ||
          resource.data.supervisorId == request.auth.uid
        ))
      );
      // Allow an active SM to fetch a specific ASM/ZSM profile or run limit(1) supervisor lookup
      allow get: if signedIn() && active() && role() == 'sm' && resource.data.role in ['asm', 'zsm'];
      allow list: if signedIn() && active() && role() == 'sm' && request.query.limit <= 1;
      
      // CREATE: super_admin, managers inviting officers, or self-registration (never super_admin)
      allow create: if signedIn() && (
        isSuperAdmin() ||
        (active() && role() in ['super_admin', 'sm', 'asm', 'zsm'] && request.resource.data.role != 'super_admin') ||
        (request.resource.data.email == request.auth.token.email && request.resource.data.role != 'super_admin')
      );
      
      // UPDATE: Self or tenant-scoped manager or super_admin
      allow update: if signedIn() && (
        isSuperAdmin() ||
        resource.data.email == request.auth.token.email ||
        userId == request.auth.uid ||
        (active() && (
          role() == 'super_admin' ||
          (resource.data.tenantId != null && resource.data.tenantId == tenant()) ||
          resource.data.supervisorId == request.auth.uid
        ))
      );
      
      // DELETE: Super Admin or SM offboarding RO
      allow delete: if signedIn() && (
        isSuperAdmin() ||
        (active() && (role() == 'super_admin' || (role() == 'sm' && resource.data.tenantId == tenant())))
      );
    }

    // -------------------------------------------------------------
    // 3. WORKSPACES & BRANCH HUBS (/workspaces)
    // -------------------------------------------------------------
    match /workspaces/{wsId} {
      // Authenticated users and DSEs can read workspaces to discover branches
      allow read: if signedIn();
      allow create: if signedIn() && (
        isSuperAdmin() ||
        (request.resource.data.keys().hasAll(['name', 'managerName']) && request.resource.data.status == 'active')
      );
      allow delete: if isSuperAdmin();
      allow update: if signedIn() && (
        isSuperAdmin() ||
        (active() && (
          (role() == 'sm' && wsId == tenant()) ||
          role() in ['asm', 'zsm']
        ))
      );
    }

    // -------------------------------------------------------------
    // 4. LOAN FILES (/loanFiles)
    // -------------------------------------------------------------
    match /loanFiles/{fileId} {
      allow read: if signedIn() && (
        isSuperAdmin() ||
        (active() && (
          role() in ['super_admin', 'zsm', 'asm'] ||
          (resource.data.tenantId != null && resource.data.tenantId == tenant()) ||
          resource.data.roId == request.auth.uid ||
          resource.data.userId == request.auth.uid ||
          resource.data.dseId == request.auth.uid ||
          (resource.data.userEmail != null && resource.data.userEmail == request.auth.token.email)
        ))
      );

      allow create: if signedIn() && (
        isSuperAdmin() ||
        (active() && (
          (request.resource.data.tenantId != null && request.resource.data.tenantId == tenant()) ||
          (role() == 'dse' && request.resource.data.dseId == request.auth.uid) ||
          role() in ['super_admin', 'sm', 'ro']
        ))
      );

      allow update: if signedIn() && (
        isSuperAdmin() ||
        (active() && (
          role() in ['super_admin', 'zsm', 'asm'] ||
          (resource.data.tenantId != null && resource.data.tenantId == tenant()) ||
          resource.data.roId == request.auth.uid ||
          resource.data.userId == request.auth.uid ||
          resource.data.dseId == request.auth.uid
        ))
      );

      allow delete: if signedIn() && (
        isSuperAdmin() ||
        (active() && (
          resource.data.roId == request.auth.uid ||
          resource.data.userId == request.auth.uid ||
          (role() == 'sm' && resource.data.tenantId == tenant())
        ))
      );
    }

    // -------------------------------------------------------------
    // 5. DAILY EOD SUBMISSIONS (/eod_reports)
    // -------------------------------------------------------------
    match /eod_reports/{reportId} {
      allow read: if signedIn() && (
        isSuperAdmin() ||
        (active() && (
          role() in ['super_admin', 'zsm', 'asm'] ||
          (resource.data.tenantId != null && resource.data.tenantId == tenant()) ||
          resource.data.userId == request.auth.uid
        ))
      );

      allow create: if signedIn() && (
        isSuperAdmin() ||
        (active() && (
          (request.resource.data.tenantId != null && request.resource.data.tenantId == tenant()) ||
          request.resource.data.userId == request.auth.uid ||
          request.resource.data.userId == dir().userId
        ))
      );

      allow update: if signedIn() && (
        isSuperAdmin() ||
        (active() && (
          resource.data.userId == request.auth.uid ||
          resource.data.userId == dir().userId ||
          (role() == 'sm' && resource.data.tenantId != null && resource.data.tenantId == tenant())
        ))
      );

      allow delete: if isSuperAdmin();
    }

    // -------------------------------------------------------------
    // 6. INVITATIONS (/invitations)
    // -------------------------------------------------------------
    match /invitations/{inviteId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if signedIn() && (isSuperAdmin() || (active() && resource.data.fromUserId == request.auth.uid));
    }

    // -------------------------------------------------------------
    // 7. SALES TARGETS & DRIVES (/salesTargets, /salesDrives)
    // -------------------------------------------------------------
    match /salesTargets/{id} {
      allow read: if signedIn();
      allow write: if signedIn() && (isSuperAdmin() || (active() && role() in ['sm', 'asm', 'zsm', 'super_admin']));
    }

    match /salesDrives/{id} {
      allow read: if signedIn();
      allow write: if signedIn() && (isSuperAdmin() || (active() && role() in ['sm', 'asm', 'zsm', 'super_admin']));
    }

    // -------------------------------------------------------------
    // 8. SYSTEM CONFIG & OWNERS (/system)
    // -------------------------------------------------------------
    match /system/{document=**} {
      allow read: if signedIn();
      allow write: if isSuperAdmin();
    }

    // -------------------------------------------------------------
    // 9. PUBLIC LEAD INTAKE (/publicLeads)
    // -------------------------------------------------------------
    match /publicLeads/{id} {
      allow create: if request.resource.data.keys().hasAll(['tenantId','customerName','customerPhone','loanAmount','createdAt'])
                    && request.resource.data.loanAmount > 0
                    && request.resource.data.customerPhone is string
                    && request.resource.data.customerPhone.size() >= 10
                    && request.resource.data.tenantId is string;
      allow read: if signedIn() && (isSuperAdmin() || (active() && (role() in ['super_admin', 'sm', 'asm', 'zsm'])));
      allow update, delete: if isSuperAdmin();
    }

    // -------------------------------------------------------------
    // 10. IMMUTABLE AUDIT LOG (/auditLog)
    // -------------------------------------------------------------
    match /auditLog/{id} {
      allow create: if signedIn();
      allow read: if isSuperAdmin();
      allow update, delete: if false;
    }
  }
}
